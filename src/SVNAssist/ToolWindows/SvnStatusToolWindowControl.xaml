<!--
  Pannello "SVN Changes" (Remote UI), sul modello di Git Changes:
  - in alto branch, Refresh, Update; messaggio di commit; Commit / Genera con AI / Migliora / lingua
  - sezioni Conflitti / Modifiche / Non versionati in una ListBox appiattita (albero o lista)
  - riga di sezione, di cartella e di file: tre layout nello stesso template, mostrati da DataTrigger
  - pannello diff, checklist dei prerequisiti, barra di stato

  Vincoli Remote UI: nessun convertitore e nessun code-behind (stringhe e bool sono precalcolati nel ViewModel),
  niente TreeView/Expander/Popup.
-->
<DataTemplate xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:vs="http://schemas.microsoft.com/visualstudio/extensibility/2022/xaml"
              xmlns:styles="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0">
  <Grid Margin="6,4"
        Background="{DynamicResource {x:Static styles:VsBrushes.ToolWindowBackgroundKey}}">
    <Grid.Resources>
      <!-- Testo tematizzato di default: senza, in tema scuro i TextBlock restano neri su nero -->
      <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource {x:Static styles:VsBrushes.ToolWindowTextKey}}"/>
      </Style>
      <Style TargetType="TextBox"
             BasedOn="{StaticResource {x:Static styles:VsResourceKeys.ThemedDialogTextBoxStyleKey}}"/>
      <Style TargetType="Button"
             BasedOn="{StaticResource {x:Static styles:VsResourceKeys.ThemedDialogButtonStyleKey}}"/>
      <Style TargetType="CheckBox"
             BasedOn="{StaticResource {x:Static styles:VsResourceKeys.ThemedDialogCheckBoxStyleKey}}"/>
      <Style TargetType="ComboBox"
             BasedOn="{StaticResource {x:Static styles:VsResourceKeys.ThemedDialogComboBoxStyleKey}}"/>
      <Style TargetType="ListBox"
             BasedOn="{StaticResource {x:Static styles:VsResourceKeys.ThemedDialogListBoxStyleKey}}"/>

      <!-- Testo secondario (cartelle, conteggi, dettagli) -->
      <Style x:Key="SecondaryText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource {x:Static styles:VsBrushes.GrayTextKey}}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
      </Style>

      <!-- Bottone "piatto" per chevron e nomi cliccabili -->
      <Style x:Key="FlatButton" TargetType="Button"
             BasedOn="{StaticResource {x:Static styles:VsResourceKeys.ThemedDialogButtonStyleKey}}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
      </Style>
    </Grid.Resources>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Row 0: percorso working copy (solo se non auto-rilevato) -->
    <DockPanel Grid.Row="0" Margin="0,0,0,4">
      <DockPanel.Style>
        <Style TargetType="DockPanel">
          <Style.Triggers>
            <DataTrigger Binding="{Binding ShowWorkingCopyInput}" Value="False">
              <Setter Property="Visibility" Value="Collapsed"/>
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </DockPanel.Style>
      <TextBlock Text="Working Copy:" DockPanel.Dock="Left" VerticalAlignment="Center"
                 Margin="0,0,6,0" FontWeight="SemiBold"/>
      <TextBox Text="{Binding WorkingCopyPath, Mode=TwoWay}" VerticalAlignment="Center"/>
    </DockPanel>

    <!-- Row 1: branch, Refresh, Update -->
    <DockPanel Grid.Row="1" Margin="0,0,0,4">
      <Button DockPanel.Dock="Right" Content="Update" Command="{Binding UpdateCommand}"
              ToolTip="Aggiorna la working copy (svn update)" Padding="8,2" Margin="4,0,0,0"/>
      <Button DockPanel.Dock="Right" Content="Refresh" Command="{Binding RefreshCommand}"
              ToolTip="Ricarica le modifiche (svn status)" Padding="8,2"/>
      <TextBlock Text="{Binding BranchName}" VerticalAlignment="Center" FontWeight="SemiBold"
                 TextTrimming="CharacterEllipsis" Margin="2,0,6,0"/>
    </DockPanel>

    <!-- Row 2: checklist prerequisiti (comprimibile) -->
    <Border Grid.Row="2" BorderThickness="1" Padding="6" Margin="0,0,0,4"
            BorderBrush="{DynamicResource {x:Static styles:VsBrushes.GrayTextKey}}">
      <Border.Style>
        <Style TargetType="Border">
          <Style.Triggers>
            <DataTrigger Binding="{Binding Prerequisites.IsOpen}" Value="False">
              <Setter Property="Visibility" Value="Collapsed"/>
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
          <Button DockPanel.Dock="Right" Content="Chiudi" Command="{Binding Prerequisites.CloseCommand}"
                  Padding="6,1" FontSize="11" Margin="4,0,0,0"/>
          <Button DockPanel.Dock="Right" Content="Ricontrolla" Command="{Binding Prerequisites.RecheckCommand}"
                  Padding="6,1" FontSize="11"/>
          <TextBlock Text="Prerequisiti" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="{Binding Prerequisites.AiSummary}" TextWrapping="Wrap"
                   FontSize="11" Margin="0,0,0,4"/>
        <TextBlock DockPanel.Dock="Top" Text="{Binding Prerequisites.Feedback}" TextWrapping="Wrap"
                   FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Style.Triggers>
                <DataTrigger Binding="{Binding Prerequisites.HasFeedback}" Value="False">
                  <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
        <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding Prerequisites.Items}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="0,2">
                  <TextBlock Text="{Binding GroupHeader}" FontWeight="SemiBold" Margin="0,6,0,2">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding HasGroupHeader}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="{Binding StatusText}" Foreground="{Binding StatusColor}"
                               FontWeight="Bold" Width="18" VerticalAlignment="Top"/>
                    <StackPanel>
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                      <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" FontSize="11">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}">
                            <Setter Property="TextTrimming" Value="None"/>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                      <TextBox Text="{Binding Instructions, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                               FontFamily="Consolas" FontSize="11" Margin="0,2,0,0">
                        <TextBox.Style>
                          <Style TargetType="TextBox"
                                 BasedOn="{StaticResource {x:Static styles:VsResourceKeys.ThemedDialogTextBoxStyleKey}}">
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding HasInstructions}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed"/>
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBox.Style>
                      </TextBox>
                      <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <Button Content="{Binding PrimaryLabel}"
                                Command="{Binding DataContext.Prerequisites.RunPrimaryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}" Padding="8,1" FontSize="11" Margin="0,0,4,0">
                          <Button.Style>
                            <Style TargetType="Button"
                                   BasedOn="{StaticResource {x:Static styles:VsResourceKeys.ThemedDialogButtonStyleKey}}">
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding HasPrimary}" Value="False">
                                  <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Button.Style>
                        </Button>
                        <Button Content="{Binding SecondaryLabel}"
                                Command="{Binding DataContext.Prerequisites.RunSecondaryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}" Padding="8,1" FontSize="11">
                          <Button.Style>
                            <Style TargetType="Button"
                                   BasedOn="{StaticResource {x:Static styles:VsResourceKeys.ThemedDialogButtonStyleKey}}">
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding HasSecondary}" Value="False">
                                  <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Button.Style>
                        </Button>
                      </StackPanel>
                    </StackPanel>
                  </DockPanel>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- Row 3: messaggio di commit, bottoni, lingua, stato AI -->
    <StackPanel Grid.Row="3" Margin="0,0,0,4">
      <TextBox Text="{Binding CommitMessage.Text, Mode=TwoWay}"
               MinHeight="52" MaxHeight="110" AcceptsReturn="True" TextWrapping="Wrap"
               VerticalScrollBarVisibility="Auto" Margin="0,0,0,4"/>

      <DockPanel>
        <ComboBox DockPanel.Dock="Right" Width="82" Margin="4,0,0,0"
                  ItemsSource="{Binding CommitMessage.LanguageOptions}"
                  SelectedItem="{Binding CommitMessage.SelectedLanguage, Mode=TwoWay}"
                  ToolTip="Lingua del messaggio generato (Auto = lingua del codice)"/>
        <Button DockPanel.Dock="Right" Content="Migliora" Command="{Binding CommitMessage.ImproveCommand}"
                IsEnabled="{Binding CommitMessage.IsIdle}"
                ToolTip="Migliora il messaggio scritto con l'AI" Padding="8,2" Margin="4,0,0,0"/>
        <Button DockPanel.Dock="Right" Content="Genera con AI" Command="{Binding CommitMessage.GenerateCommand}"
                IsEnabled="{Binding CommitMessage.IsIdle}"
                ToolTip="Genera il messaggio dal diff dei file selezionati" Padding="8,2" Margin="4,0,0,0"/>
        <Button Content="Commit" Command="{Binding CommitCommand}" Padding="12,2" FontWeight="SemiBold"
                ToolTip="Commit dei file selezionati" HorizontalAlignment="Left"/>
      </DockPanel>

      <TextBlock Text="{Binding CommitMessage.AiStatus}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap">
        <TextBlock.Style>
          <Style TargetType="TextBlock">
            <Style.Triggers>
              <DataTrigger Binding="{Binding CommitMessage.AiStatus}" Value="">
                <Setter Property="Visibility" Value="Collapsed"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>
    </StackPanel>

    <!-- Row 4: barra strumenti della lista -->
    <StackPanel Grid.Row="4" Margin="0,0,0,2">
      <DockPanel Margin="0,0,0,2">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Content="Albero" Command="{Binding ShowTreeViewCommand}" Padding="6,1" FontSize="11"
                  ToolTip="Vista ad albero per cartelle">
            <Button.Style>
              <Style TargetType="Button"
                     BasedOn="{StaticResource {x:Static styles:VsResourceKeys.ThemedDialogButtonStyleKey}}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsTreeView}" Value="True">
                    <Setter Property="FontWeight" Value="Bold"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
          </Button>
          <Button Content="Lista" Command="{Binding ShowListViewCommand}" Padding="6,1" FontSize="11"
                  Margin="2,0,0,0" ToolTip="Vista a elenco piatto">
            <Button.Style>
              <Style TargetType="Button"
                     BasedOn="{StaticResource {x:Static styles:VsResourceKeys.ThemedDialogButtonStyleKey}}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsTreeView}" Value="False">
                    <Setter Property="FontWeight" Value="Bold"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
          </Button>
        </StackPanel>
        <Button DockPanel.Dock="Left" Content="Seleziona tutto" Command="{Binding SelectAllCommand}"
                Padding="6,1" FontSize="11" Margin="0,0,2,0"/>
        <Button DockPanel.Dock="Left" Content="Deseleziona" Command="{Binding UnselectAllCommand}"
                Padding="6,1" FontSize="11" HorizontalAlignment="Left"/>
      </DockPanel>
      <StackPanel Orientation="Horizontal">
        <StackPanel.Style>
          <Style TargetType="StackPanel">
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsTreeView}" Value="False">
                <Setter Property="Visibility" Value="Collapsed"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </StackPanel.Style>
        <Button Content="Espandi tutto" Command="{Binding ExpandAllCommand}" Padding="6,1" FontSize="11" Margin="0,0,2,0"/>
        <Button Content="Comprimi tutto" Command="{Binding CollapseAllCommand}" Padding="6,1" FontSize="11"/>
      </StackPanel>
    </StackPanel>

    <!-- Row 5: lista appiattita (sezioni, cartelle, file) -->
    <Grid Grid.Row="5">
      <ListBox ItemsSource="{Binding Rows}"
               HorizontalContentAlignment="Stretch"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               BorderThickness="1" Padding="0">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel>

              <!-- Riga di sezione: chevron, checkbox, titolo con conteggio -->
              <DockPanel Margin="0,2" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}">
                <DockPanel.Style>
                  <Style TargetType="DockPanel">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsSection}" Value="False">
                        <Setter Property="Visibility" Value="Collapsed"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </DockPanel.Style>
                <Button DockPanel.Dock="Left" Style="{StaticResource FlatButton}" Content="{Binding Chevron}" Width="18"
                        Command="{Binding DataContext.ToggleExpandCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                        CommandParameter="{Binding}"/>
                <CheckBox DockPanel.Dock="Left" IsThreeState="True" IsChecked="{Binding IsChecked, Mode=TwoWay}"
                          VerticalAlignment="Center" Margin="0,0,6,0"/>
                <Button Style="{StaticResource FlatButton}"
                        Command="{Binding DataContext.ToggleExpandCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                        CommandParameter="{Binding}" ToolTip="{Binding ToolTip}">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                </Button>
                <DockPanel.ContextMenu>
                  <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                    <MenuItem Header="Aggiungi tutti a SVN"
                              Command="{Binding AddToSvnCommand}"
                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              IsEnabled="{Binding PlacementTarget.DataContext.CanAdd, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                    <MenuItem Header="Revert tutto"
                              Command="{Binding RevertCommand}"
                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              IsEnabled="{Binding PlacementTarget.DataContext.CanRevert, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                    <Separator/>
                    <MenuItem Header="Espandi tutto" Command="{Binding ExpandAllCommand}"/>
                    <MenuItem Header="Comprimi tutto" Command="{Binding CollapseAllCommand}"/>
                  </ContextMenu>
                </DockPanel.ContextMenu>
              </DockPanel>

              <!-- Riga di cartella: indentazione, chevron, checkbox, nome, conteggio -->
              <DockPanel Margin="0,1" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}">
                <DockPanel.Style>
                  <Style TargetType="DockPanel">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsFolder}" Value="False">
                        <Setter Property="Visibility" Value="Collapsed"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </DockPanel.Style>
                <Border DockPanel.Dock="Left" Width="{Binding IndentWidth}"/>
                <Button DockPanel.Dock="Left" Style="{StaticResource FlatButton}" Content="{Binding Chevron}" Width="18"
                        Command="{Binding DataContext.ToggleExpandCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                        CommandParameter="{Binding}"/>
                <CheckBox DockPanel.Dock="Left" IsThreeState="True" IsChecked="{Binding IsChecked, Mode=TwoWay}"
                          VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBlock DockPanel.Dock="Right" Text="{Binding Detail}" Style="{StaticResource SecondaryText}"
                           VerticalAlignment="Center" Margin="6,0,4,0"/>
                <Button Style="{StaticResource FlatButton}"
                        Command="{Binding DataContext.ToggleExpandCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                        CommandParameter="{Binding}" ToolTip="{Binding ToolTip}">
                  <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                </Button>
                <DockPanel.ContextMenu>
                  <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                    <MenuItem Header="SVN Add (contenuto non versionato)"
                              Command="{Binding AddToSvnCommand}"
                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              IsEnabled="{Binding PlacementTarget.DataContext.CanAdd, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                    <MenuItem Header="SVN Revert cartella"
                              Command="{Binding RevertCommand}"
                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              IsEnabled="{Binding PlacementTarget.DataContext.CanRevert, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                    <MenuItem Header="Aggiungi a ignore list"
                              Command="{Binding AddToIgnoreListCommand}"
                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              IsEnabled="{Binding PlacementTarget.DataContext.CanIgnore, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                    <MenuItem Header="Diff cartella"
                              Command="{Binding ShowFolderDiffCommand}"
                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              IsEnabled="{Binding PlacementTarget.DataContext.CanDiff, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                    <Separator/>
                    <MenuItem Header="Espandi tutto" Command="{Binding ExpandAllCommand}"/>
                    <MenuItem Header="Comprimi tutto" Command="{Binding CollapseAllCommand}"/>
                  </ContextMenu>
                </DockPanel.ContextMenu>
              </DockPanel>

              <!-- Riga di file: indentazione, spazio del chevron, checkbox, stato, nome, cartella grigia, Diff -->
              <DockPanel Margin="0,1" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}">
                <DockPanel.Style>
                  <Style TargetType="DockPanel">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsFile}" Value="False">
                        <Setter Property="Visibility" Value="Collapsed"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </DockPanel.Style>
                <Button DockPanel.Dock="Right" Content="Diff" Padding="6,0" FontSize="11" Margin="4,0,2,0"
                        VerticalAlignment="Center"
                        Command="{Binding DataContext.ShowFileDiffCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                        CommandParameter="{Binding}" IsEnabled="{Binding CanDiff}"/>
                <Border DockPanel.Dock="Left" Width="{Binding IndentWidth}"/>
                <Border DockPanel.Dock="Left" Width="18"/>
                <CheckBox DockPanel.Dock="Left" IsThreeState="True" IsChecked="{Binding IsChecked, Mode=TwoWay}"
                          VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBlock DockPanel.Dock="Left" Text="{Binding StatusText}" Foreground="{Binding StatusColor}"
                           FontFamily="Consolas" FontWeight="Bold" Width="14" VerticalAlignment="Center"/>
                <Button DockPanel.Dock="Left" Style="{StaticResource FlatButton}" ToolTip="{Binding ToolTip}"
                        Command="{Binding DataContext.ShowFileDiffCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                        CommandParameter="{Binding}" IsEnabled="{Binding CanDiff}">
                  <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                </Button>
                <TextBlock Text="{Binding Detail}" Style="{StaticResource SecondaryText}"
                           VerticalAlignment="Center" Margin="6,0,0,0"/>
                <DockPanel.ContextMenu>
                  <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                    <MenuItem Header="SVN Add"
                              Command="{Binding AddToSvnCommand}"
                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              IsEnabled="{Binding PlacementTarget.DataContext.CanAdd, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                    <MenuItem Header="Aggiungi a ignore list"
                              Command="{Binding AddToIgnoreListCommand}"
                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              IsEnabled="{Binding PlacementTarget.DataContext.CanIgnore, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                    <MenuItem Header="SVN Delete"
                              Command="{Binding DeleteFromSvnCommand}"
                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              IsEnabled="{Binding PlacementTarget.DataContext.CanDelete, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                    <MenuItem Header="SVN Revert"
                              Command="{Binding RevertCommand}"
                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              IsEnabled="{Binding PlacementTarget.DataContext.CanRevert, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                    <Separator/>
                    <MenuItem Header="Risolvi conflitto..."
                              Command="{Binding ResolveConflictCommand}"
                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              IsEnabled="{Binding PlacementTarget.DataContext.CanResolve, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                    <Separator/>
                    <MenuItem Header="Mostra diff"
                              Command="{Binding ShowFileDiffCommand}"
                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              IsEnabled="{Binding PlacementTarget.DataContext.CanDiff, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                  </ContextMenu>
                </DockPanel.ContextMenu>
              </DockPanel>

            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <TextBlock Text="Nessuna modifica." HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,16,0,0">
        <TextBlock.Style>
          <Style TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}">
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsEmpty}" Value="False">
                <Setter Property="Visibility" Value="Collapsed"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>
    </Grid>

    <!-- Row 6: pannello diff -->
    <Grid Grid.Row="6" Margin="0,4,0,0">
      <Grid.Style>
        <Style TargetType="Grid">
          <Style.Triggers>
            <DataTrigger Binding="{Binding IsDiffVisible}" Value="False">
              <Setter Property="Visibility" Value="Collapsed"/>
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Grid.Style>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="200"/>
      </Grid.RowDefinitions>
      <DockPanel Grid.Row="0" Margin="0,0,0,2">
        <Button DockPanel.Dock="Right" Content="Chiudi" Command="{Binding CloseDiffCommand}"
                Padding="6,1" FontSize="11" VerticalAlignment="Center"/>
        <TextBlock Text="{Binding DiffTitle}" FontWeight="SemiBold" FontSize="11"
                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
      </DockPanel>
      <TextBox Grid.Row="1" Text="{Binding DiffContent, Mode=OneWay}" IsReadOnly="True"
               FontFamily="Consolas" FontSize="11" TextWrapping="NoWrap"
               VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" BorderThickness="1"/>
    </Grid>

    <!-- Row 7: stato e toggle prerequisiti -->
    <StackPanel Grid.Row="7" Margin="0,4,0,0">
      <TextBlock Text="{Binding StatusMessage}" FontSize="11" TextWrapping="Wrap">
        <TextBlock.Style>
          <Style TargetType="TextBlock">
            <Style.Triggers>
              <DataTrigger Binding="{Binding StatusMessage}" Value="">
                <Setter Property="Visibility" Value="Collapsed"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>
      <Button Content="{Binding Prerequisites.SummaryText}" Command="{Binding Prerequisites.ToggleCommand}"
              Padding="6,1" FontSize="11" HorizontalAlignment="Left" Margin="0,4,0,0"
              ToolTip="Mostra/nasconde la checklist dei prerequisiti (svn, TortoiseSVN, provider AI)"/>
    </StackPanel>
  </Grid>
</DataTemplate>
