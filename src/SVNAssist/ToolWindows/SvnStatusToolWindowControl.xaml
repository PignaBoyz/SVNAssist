<!--
  SvnStatusToolWindowControl.xaml — Remote UI
  =============================================
  Questo XAML viene embeddato come risorsa e renderizzato nel processo di Visual Studio.
  I dati arrivano dal ViewModel (SvnStatusToolWindowData) tramite data binding remoto.

  Differenze con WPF normale:
  - Non c'è code-behind (nessun .xaml.cs con event handler)
  - Tutto passa per data binding e comandi
  - Supporta un sottoinsieme dei controlli WPF standard
  - L'elemento root è DataTemplate, non Window o UserControl
-->
<DataTemplate xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:vs="http://schemas.microsoft.com/visualstudio/extensibility/2022/xaml">
  <Grid Margin="8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Riga 0: Percorso della working copy -->
    <DockPanel Grid.Row="0" Margin="0,0,0,8">
      <TextBlock Text="Working Copy:"
                 DockPanel.Dock="Left"
                 VerticalAlignment="Center"
                 Margin="0,0,8,0"
                 FontWeight="SemiBold"/>
      <TextBox Text="{Binding WorkingCopyPath, Mode=TwoWay}"
               VerticalAlignment="Center"/>
    </DockPanel>

    <!-- Riga 1: Toolbar con i bottoni -->
    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
      <Button Content="🔄 Refresh"
              Command="{Binding RefreshCommand}"
              Padding="12,4"
              Margin="0,0,8,0"/>
      <Button Content="📤 Commit selezionati"
              Command="{Binding CommitSelectedCommand}"
              Padding="12,4"/>
    </StackPanel>

    <!-- Riga 2: Lista dei file modificati -->
    <ListBox Grid.Row="2"
             ItemsSource="{Binding Files}"
             HorizontalContentAlignment="Stretch"
             ScrollViewer.HorizontalScrollBarVisibility="Auto">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <DockPanel Margin="2">
            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                      DockPanel.Dock="Left"
                      VerticalAlignment="Center"
                      Margin="0,0,8,0"/>
            <TextBlock DockPanel.Dock="Left"
                       Text="{Binding Status}"
                       Width="80"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0"/>
            <TextBlock Text="{Binding Path}"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>
          </DockPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <!-- Riga 3: Barra di stato -->
    <TextBlock Grid.Row="3"
               Text="{Binding StatusMessage}"
               Margin="0,8,0,0"
               FontStyle="Italic"/>
  </Grid>
</DataTemplate>
