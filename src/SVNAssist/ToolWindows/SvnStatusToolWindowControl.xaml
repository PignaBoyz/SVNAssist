<DataTemplate xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:vs="http://schemas.microsoft.com/visualstudio/extensibility/2022/xaml"
              xmlns:styles="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0">
  <Grid Margin="6,4">
    <Grid.Resources>
      <Style TargetType="TextBox"
             BasedOn="{StaticResource {x:Static styles:VsResourceKeys.ThemedDialogTextBoxStyleKey}}"/>
      <Style TargetType="Button"
             BasedOn="{StaticResource {x:Static styles:VsResourceKeys.ThemedDialogButtonStyleKey}}"/>
      <Style TargetType="CheckBox"
             BasedOn="{StaticResource {x:Static styles:VsResourceKeys.ThemedDialogCheckBoxStyleKey}}"/>
      <Style TargetType="ComboBox"
             BasedOn="{StaticResource {x:Static styles:VsResourceKeys.ThemedDialogComboBoxStyleKey}}"/>
      <Style TargetType="ListBox"
             BasedOn="{StaticResource {x:Static styles:VsResourceKeys.ThemedDialogListBoxStyleKey}}"/>
    </Grid.Resources>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Row 0: Working copy path (visibile solo se non auto-rilevato) -->
    <DockPanel Grid.Row="0" Margin="0,0,0,4">
      <DockPanel.Style>
        <Style TargetType="DockPanel">
          <Style.Triggers>
            <DataTrigger Binding="{Binding ShowWorkingCopyInput}" Value="False">
              <Setter Property="Visibility" Value="Collapsed"/>
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </DockPanel.Style>
      <TextBlock Text="Working Copy:"
                 DockPanel.Dock="Left"
                 VerticalAlignment="Center"
                 Margin="0,0,6,0"
                 FontWeight="SemiBold"/>
      <TextBox Text="{Binding WorkingCopyPath, Mode=TwoWay}"
               VerticalAlignment="Center"/>
    </DockPanel>

    <!-- Row 1: Header con branch e bottoni -->
    <DockPanel Grid.Row="1" Margin="0,0,0,2">
      <Button DockPanel.Dock="Left"
              Content="Refresh"
              Command="{Binding RefreshCommand}"
              ToolTip="Aggiorna lista file (svn status)"
              Padding="6,2"
              Margin="0,0,6,0"/>
      <Button DockPanel.Dock="Right"
              Content="Update"
              Command="{Binding UpdateCommand}"
              ToolTip="Aggiorna working copy (svn update)"
              Padding="8,2"/>
      <TextBlock Text="{Binding BranchName}"
                 VerticalAlignment="Center"
                 FontWeight="SemiBold"
                 TextTrimming="CharacterEllipsis"
                 Margin="2,0,6,0"/>
    </DockPanel>

    <!-- Row 2: Separatore -->
    <Separator Grid.Row="2" Margin="0,4,0,4"/>

    <!-- Row 3: Commit message + bottoni -->
    <StackPanel Grid.Row="3" Margin="0,0,0,4">
      <TextBox Text="{Binding CommitMessage, Mode=TwoWay}"
               Style="{StaticResource {x:Static styles:VsResourceKeys.ThemedDialogTextBoxStyleKey}}"
               MinHeight="48"
               MaxHeight="96"
               AcceptsReturn="True"
               TextWrapping="Wrap"
               VerticalScrollBarVisibility="Auto"
               Margin="0,0,0,4"/>

      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Content="Generate AI"
                  Command="{Binding GenerateAiCommand}"
                  ToolTip="Genera messaggio di commit analizzando il diff con AI"
                  Padding="8,2"
                  Margin="4,0,0,0"/>
          <Button Content="Improve"
                  Command="{Binding ImproveAiCommand}"
                  ToolTip="Migliora il messaggio di commit esistente con AI"
                  Padding="8,2"
                  Margin="4,0,0,0"/>
        </StackPanel>
        <Button Content="Commit"
                Command="{Binding CommitCommand}"
                Padding="12,2"
                FontWeight="SemiBold"
                HorizontalAlignment="Left"/>
      </DockPanel>

      <!-- Stato AI -->
      <TextBlock Text="{Binding AiStatusMessage}"
                 FontSize="11"
                 Margin="0,4,0,0"
                 TextWrapping="Wrap">
        <TextBlock.Style>
          <Style TargetType="TextBlock">
            <Style.Triggers>
              <DataTrigger Binding="{Binding AiStatusMessage}" Value="">
                <Setter Property="Visibility" Value="Collapsed"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>
    </StackPanel>

    <!-- Row 4: Separatore -->
    <Separator Grid.Row="4" Margin="0,2,0,4"/>

    <!-- Row 5: Header lista file -->
    <DockPanel Grid.Row="5" Margin="0,0,0,2">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button Content="Select All"
                Command="{Binding SelectAllCommand}"
                ToolTip="Seleziona tutti i file"
                Padding="6,1"
                Margin="0,0,4,0"
                FontSize="11"/>
        <Button Content="Deselect All"
                Command="{Binding UnselectAllCommand}"
                ToolTip="Deseleziona tutti i file"
                Padding="6,1"
                FontSize="11"/>
      </StackPanel>
      <Label Content="{Binding FileListHeader}"
             Style="{StaticResource {x:Static styles:VsResourceKeys.ThemedDialogLabelStyleKey}}"
             VerticalAlignment="Center"
             Padding="0"/>
    </DockPanel>

    <!-- Row 6: Lista file -->
    <ListBox Grid.Row="6"
              ItemsSource="{Binding Files}"
              HorizontalContentAlignment="Stretch"
              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
              BorderThickness="1"
              Padding="0">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <!-- Riga cliccabile sul nome file + bottone Diff dedicato -->
            <Grid Margin="2,2"
                  Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="96"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
            <CheckBox Grid.Column="0"
                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                      VerticalAlignment="Center"
                      Margin="0,0,6,0"/>
            <TextBlock Grid.Column="1"
                       Text="{Binding Status}"
                       Width="20"
                       FontWeight="Bold"
                       FontFamily="Consolas"
                       Foreground="{Binding StatusColor}"
                       VerticalAlignment="Center"
                       Margin="0,0,6,0"/>
            <TextBlock Grid.Column="2"
                       Text="{Binding Action}"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0"
                       Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}"/>
            <Button Grid.Column="3"
                    Command="{Binding DataContext.ShowFileDiffCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                    CommandParameter="{Binding}"
                    HorizontalContentAlignment="Left"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="0"
                    Cursor="Hand"
                    Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}"
                    ToolTip="{Binding FullPath}">
              <TextBlock Text="{Binding Path}"
                         Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}"
                         VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis"/>
            </Button>
            <Button Grid.Column="4"
                    Content="Diff"
                    Command="{Binding DataContext.ShowFileDiffCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                    CommandParameter="{Binding}"
                    Padding="6,1"
                    Margin="4,0,0,0"
                    FontSize="11"
                    VerticalAlignment="Center"/>
            <Grid.ContextMenu>
              <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                <MenuItem Header="SVN Add"
                          Command="{Binding AddToSvnCommand}"
                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                          ToolTip="Aggiunge a SVN il file cliccato (o la selezione se nessun target è passato)"
                          IsEnabled="{Binding PlacementTarget.DataContext.CanAddToSvn, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                <MenuItem Header="Add to Ignore List"
                          Command="{Binding AddToIgnoreListCommand}"
                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                          IsEnabled="{Binding PlacementTarget.DataContext.CanAddToIgnoreList, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                <MenuItem Header="SVN Delete"
                          Command="{Binding DeleteFromSvnCommand}"
                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                          IsEnabled="{Binding PlacementTarget.DataContext.CanDeleteFromSvn, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                <MenuItem Header="SVN Revert"
                          Command="{Binding RevertSelectedCommand}"
                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                          IsEnabled="{Binding PlacementTarget.DataContext.CanRevert, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                <Separator/>
                <MenuItem Header="Resolve Conflict"
                          Command="{Binding ResolveConflictCommand}"
                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                          IsEnabled="{Binding PlacementTarget.DataContext.CanResolveConflict, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                <Separator/>
                <MenuItem Header="Show Diff"
                          Command="{Binding ShowFileDiffCommand}"
                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
              </ContextMenu>
            </Grid.ContextMenu>
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <!-- Row 7: Pannello diff -->
    <Grid Grid.Row="7" Margin="0,4,0,0">
      <Grid.Style>
        <Style TargetType="Grid">
          <Style.Triggers>
            <DataTrigger Binding="{Binding IsDiffVisible}" Value="False">
              <Setter Property="Visibility" Value="Collapsed"/>
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Grid.Style>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="200"/>
      </Grid.RowDefinitions>
      <DockPanel Grid.Row="0" Margin="0,0,0,2">
        <Button DockPanel.Dock="Right"
                Content="Close"
                Command="{Binding CloseDiffCommand}"
                Padding="6,1"
                FontSize="11"
                VerticalAlignment="Center"/>
        <TextBlock Text="{Binding DiffTitle}"
                   FontWeight="SemiBold"
                   FontSize="11"
                   VerticalAlignment="Center"/>
      </DockPanel>
      <TextBox Grid.Row="1"
                Text="{Binding DiffContent}"
                Style="{StaticResource {x:Static styles:VsResourceKeys.ThemedDialogTextBoxStyleKey}}"
                IsReadOnly="True"
                FontFamily="Consolas"
                FontSize="11"
                TextWrapping="NoWrap"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Auto"
                BorderThickness="1"/>
    </Grid>

    <!-- Row 8: Barra di stato -->
    <TextBlock Grid.Row="8"
               Text="{Binding StatusMessage}"
               Margin="0,4,0,0"
               FontSize="11">
      <TextBlock.Style>
        <Style TargetType="TextBlock">
          <Style.Triggers>
            <DataTrigger Binding="{Binding StatusMessage}" Value="">
              <Setter Property="Visibility" Value="Collapsed"/>
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </TextBlock.Style>
    </TextBlock>
  </Grid>
</DataTemplate>
