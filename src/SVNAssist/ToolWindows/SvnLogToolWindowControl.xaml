<!--
  SvnLogToolWindowControl.xaml — Remote UI
  ==========================================
  Tool window per la cronologia SVN con layout a due pannelli verticali:
  - Pannello superiore: lista revisioni (Revisione, Autore, Data, Messaggio)
  - Pannello inferiore: diff testuale della revisione selezionata

  Il GridSplitter permette all'utente di ridimensionare i pannelli.
  Il click su una revisione invoca SelectRevisionCommand con il numero
  di revisione come parametro, che carica il diff nel pannello inferiore.
-->
<DataTemplate xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:vs="http://schemas.microsoft.com/visualstudio/extensibility/2022/xaml">
  <Grid Margin="8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="2*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Riga 0: Percorso e numero massimo revisioni -->
    <DockPanel Grid.Row="0" Margin="0,0,0,8">
      <TextBlock Text="Max:"
                 DockPanel.Dock="Right"
                 VerticalAlignment="Center"
                 Margin="8,0,4,0"/>
      <TextBox Text="{Binding MaxEntries, Mode=TwoWay}"
               DockPanel.Dock="Right"
               Width="50"
               VerticalAlignment="Center"/>
      <TextBlock Text="Percorso:"
                 DockPanel.Dock="Left"
                 VerticalAlignment="Center"
                 Margin="0,0,8,0"
                 FontWeight="SemiBold"/>
      <TextBox Text="{Binding WorkingCopyPath, Mode=TwoWay}"
               VerticalAlignment="Center"/>
    </DockPanel>

    <!-- Riga 1: Bottone Carica Log -->
    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
      <Button Content="📜 Carica Log"
              Command="{Binding LoadLogCommand}"
              Padding="12,4"/>
    </StackPanel>

    <!-- Riga 2: Pannello superiore — Lista revisioni -->
    <ListBox Grid.Row="2"
             ItemsSource="{Binding LogEntries}"
             HorizontalContentAlignment="Stretch"
             ScrollViewer.HorizontalScrollBarVisibility="Auto">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <!--
            Ogni riga della lista è un bottone invisibile che invoca
            SelectRevisionCommand con il numero di revisione come parametro.
            Questo pattern è necessario in Remote UI dove non c'è
            l'evento SelectionChanged — tutto passa per comandi.
          -->
          <Button Command="{Binding DataContext.SelectRevisionCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                  CommandParameter="{Binding Revision}"
                  HorizontalContentAlignment="Stretch"
                  Background="Transparent"
                  BorderThickness="0"
                  Padding="0"
                  Cursor="Hand">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="60"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>

              <TextBlock Grid.Column="0"
                         Text="{Binding Revision}"
                         FontWeight="Bold"
                         VerticalAlignment="Center"
                         Margin="4,2"/>
              <TextBlock Grid.Column="1"
                         Text="{Binding Author}"
                         VerticalAlignment="Center"
                         Margin="4,2"/>
              <TextBlock Grid.Column="2"
                         Text="{Binding Date}"
                         VerticalAlignment="Center"
                         Foreground="Gray"
                         Margin="4,2"/>
              <TextBlock Grid.Column="3"
                         Text="{Binding Message}"
                         VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis"
                         Margin="4,2"/>
            </Grid>
          </Button>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <!-- Riga 3: Intestazione pannello diff -->
    <TextBlock Grid.Row="3"
               Text="Diff revisione selezionata:"
               FontWeight="SemiBold"
               Margin="0,8,0,4"/>

    <!-- Riga 4: Pannello inferiore — Diff testuale -->
    <TextBox Grid.Row="4"
             Text="{Binding DiffText}"
             IsReadOnly="True"
             AcceptsReturn="True"
             TextWrapping="NoWrap"
             FontFamily="Consolas"
             FontSize="12"
             VerticalScrollBarVisibility="Auto"
             HorizontalScrollBarVisibility="Auto"/>

    <!-- Riga 5: Barra di stato -->
    <TextBlock Grid.Row="5"
               Text="{Binding StatusMessage}"
               Margin="0,8,0,0"
               FontStyle="Italic"/>
  </Grid>
</DataTemplate>
