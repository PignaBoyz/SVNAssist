<!--
  CommitDialogControl.xaml — Remote UI per il dialog di commit
  =============================================================
  Questo dialog viene mostrato con ShowDialogAsync.
  VS aggiunge automaticamente i bottoni OK/Cancel in basso.
  Il contenuto qui è solo la parte custom del dialog.

  Layout:
  - Lista file da committare (read-only)
  - Selettore lingua + bottoni AI con stato
  - TextBox per il messaggio di commit
  - Istruzioni
-->
<DataTemplate xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:vs="http://schemas.microsoft.com/visualstudio/extensibility/2022/xaml">
  <Grid Margin="8" MinWidth="500">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Riga 0: File selezionati (read-only) -->
    <StackPanel Grid.Row="0" Margin="0,0,0,8">
      <TextBlock Text="File da committare:"
                 FontWeight="SemiBold"
                 Margin="0,0,0,4"/>
      <ListBox ItemsSource="{Binding Files}"
               MaxHeight="120"
               IsEnabled="True">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding Path}"
                       Margin="4,2"/>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </StackPanel>

    <!-- Riga 1: Lingua e bottoni AI -->
    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,4">
      <TextBlock Text="Lingua AI:"
                 VerticalAlignment="Center"
                 Margin="0,0,8,0"/>
      <ComboBox ItemsSource="{Binding Languages}"
                SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"
                Width="100"
                Margin="0,0,16,0"/>
      <Button Content="🤖 Genera con AI"
              Command="{Binding GenerateAiCommand}"
              Padding="8,4"
              Margin="0,0,4,0"/>
      <Button Content="✨ Migliora bozza"
              Command="{Binding ImproveCommand}"
              Padding="8,4"/>
    </StackPanel>

    <!-- Riga 2: Stato AI -->
    <TextBlock Grid.Row="2"
               Text="{Binding AiStatusMessage}"
               Margin="0,0,0,8"
               FontStyle="Italic"/>

    <!-- Riga 3: Messaggio di commit -->
    <StackPanel Grid.Row="3" Margin="0,0,0,8">
      <TextBlock Text="Messaggio di commit:"
                 FontWeight="SemiBold"
                 Margin="0,0,0,4"/>
      <TextBox Text="{Binding CommitMessage, Mode=TwoWay}"
               AcceptsReturn="True"
               TextWrapping="Wrap"
               MinHeight="100"
               VerticalScrollBarVisibility="Auto"/>
    </StackPanel>

    <!-- Riga 4: Istruzioni -->
    <TextBlock Grid.Row="4"
               Text="Scrivi il messaggio e clicca OK per committare, oppure Cancel per annullare."
               FontStyle="Italic"
               Foreground="Gray"/>
  </Grid>
</DataTemplate>
