{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "changes-state.schema.json",
  "title": "Stato della vista Changes (snapshot completo)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workingCopy",
    "commit",
    "view",
    "theme",
    "sections",
    "status",
    "prereq",
    "loading",
    "wizard"
  ],
  "properties": {
    "workingCopy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "showInput",
        "branch"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "showInput": {
          "type": "boolean",
          "description": "Mostra il campo del percorso."
        },
        "branch": {
          "type": "string"
        },
        "rev": {
          "type": "integer",
          "minimum": 0,
          "description": "Revisione della working copy."
        },
        "head": {
          "type": "integer",
          "minimum": 0,
          "description": "Ultima revisione del ramo sul server (controllo periodico); assente se sconosciuta."
        },
        "revState": {
          "enum": [
            "current",
            "behind",
            "unknown"
          ],
          "description": "Indicatore nella barra di stato: current = verde (alla HEAD), behind = arancio (il server ha una revisione piu' recente), unknown = neutro."
        },
        "revNote": {
          "type": "string",
          "description": "Con revState unknown: perche' (controllo spento, errore di rete o di autenticazione); e' il tooltip dell'indicatore."
        },
        "svnVersion": {
          "type": "string",
          "description": "Versione di svn (es. 1.14.2): la UI nasconde le funzioni che richiedono svn piu' recente."
        }
      }
    },
    "commit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "aiStatus",
        "aiLevel",
        "aiSeq",
        "busy",
        "lang",
        "trace",
        "download"
      ],
      "properties": {
        "text": {
          "type": "string",
          "description": "Messaggio corrente."
        },
        "aiStatus": {
          "type": "string",
          "description": "Ultimo messaggio di stato AI."
        },
        "busy": {
          "type": "boolean",
          "description": "AI in corso."
        },
        "recent": {
          "type": "array",
          "description": "Ultimi messaggi committati per questo repository (al massimo 25, il piu' recente per primo): tendina \"Recenti\".",
          "items": {
            "type": "string"
          }
        },
        "lang": {
          "enum": [
            "auto",
            "italiano",
            "english"
          ]
        },
        "trace": {
          "type": "array",
          "description": "Catena provider AI (diagnostica).",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "state",
              "detail"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "state": {
                "enum": [
                  "wait",
                  "run",
                  "ok",
                  "fail",
                  "skip"
                ]
              },
              "detail": {
                "type": "string"
              }
            }
          }
        },
        "download": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "pct",
                "label"
              ],
              "properties": {
                "pct": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                "label": {
                  "type": "string"
                }
              }
            }
          ]
        },
        "aiLevel": {
          "enum": [
            "",
            "busy",
            "ok",
            "warn",
            "err",
            "info"
          ],
          "description": "Gravita del messaggio AI (colore/icona)."
        },
        "aiSeq": {
          "type": "integer",
          "minimum": 0,
          "description": "Cresce a ogni messaggio AI (rende visibile un messaggio ripetuto)."
        },
        "count": {
          "type": "integer",
          "minimum": 0,
          "description": "Elementi del prossimo commit: quelli in Staged, o (Staged vuoto) tutte le modifiche dei file versionati."
        },
        "all": {
          "type": "boolean",
          "description": "true se Staged e' vuoto e il commit prende tutte le modifiche: il pulsante diventa \"Commit All\"."
        }
      }
    },
    "view": {
      "enum": [
        "tree",
        "list"
      ]
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "kind"
      ],
      "properties": {
        "mode": {
          "enum": [
            "auto",
            "light",
            "dark",
            "blue"
          ]
        },
        "kind": {
          "enum": [
            "light",
            "dark",
            "blue"
          ]
        }
      }
    },
    "sections": {
      "type": "array",
      "description": "Sempre Staged, Modifiche, Non versionati (nell'ordine). Staged = i file che il commit invia; non esiste uno staging in SVN: e' un insieme tenuto dall'estensione.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "count",
          "expanded",
          "rows"
        ],
        "properties": {
          "id": {
            "enum": [
              "staged",
              "changes",
              "unversioned"
            ]
          },
          "title": {
            "type": "string"
          },
          "count": {
            "type": "integer",
            "minimum": 0,
            "description": "File nella sezione."
          },
          "expanded": {
            "type": "boolean"
          },
          "rows": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/row"
            }
          }
        }
      }
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "msg",
        "err"
      ],
      "properties": {
        "msg": {
          "type": "string"
        },
        "err": {
          "type": "boolean"
        },
        "seq": {
          "type": "integer",
          "minimum": 0,
          "description": "Cresce a ogni messaggio: un messaggio di successo ripetuto riparte da capo e sparisce dopo ~5 s."
        },
        "action": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "label",
            "cmd"
          ],
          "description": "Pulsante accanto al messaggio d'errore (es. \"Esegui Cleanup\" se la working copy e' bloccata). Facoltativo.",
          "properties": {
            "label": {
              "type": "string"
            },
            "cmd": {
              "enum": [
                "cleanup",
                "update",
                "switchResume",
                "switchBack"
              ]
            }
          }
        },
        "action2": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "label",
            "cmd"
          ],
          "description": "Secondo pulsante: \"Torna a prima dello switch\" (switchBack) accanto a \"Completa switch\", solo se la voce dello switch interrotto ricorda URL e revisione di partenza.",
          "properties": {
            "label": {
              "type": "string"
            },
            "cmd": {
              "enum": [
                "cleanup",
                "update",
                "switchResume",
                "switchBack"
              ]
            }
          }
        }
      }
    },
    "prereq": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "open",
        "summary",
        "ai",
        "feedback",
        "items"
      ],
      "properties": {
        "open": {
          "type": "boolean"
        },
        "summary": {
          "type": "string"
        },
        "ai": {
          "type": "string"
        },
        "feedback": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "group",
              "title",
              "ok",
              "detail",
              "instructions",
              "primary",
              "secondary"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "group": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "ok": {
                "type": "boolean"
              },
              "detail": {
                "type": "string"
              },
              "instructions": {
                "type": "string"
              },
              "primary": {
                "type": "string",
                "description": "Etichetta del pulsante principale (\"\" = nessuno)."
              },
              "secondary": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "loading": {
      "type": "boolean"
    },
    "wizard": {
      "type": "object",
      "additionalProperties": false,
      "description": "Procedura guidata (AI o prerequisiti).",
      "required": [
        "open",
        "mode",
        "step",
        "fromGenerate",
        "provider",
        "busy",
        "feedback",
        "providers",
        "items",
        "auth",
        "authOk",
        "authDetail",
        "endpoint",
        "models",
        "model",
        "canNext"
      ],
      "properties": {
        "open": {
          "type": "boolean"
        },
        "mode": {
          "enum": [
            "ai",
            "prereq"
          ]
        },
        "step": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "fromGenerate": {
          "type": "boolean"
        },
        "provider": {
          "enum": [
            "",
            "copilot",
            "claudecode",
            "claude",
            "openai"
          ]
        },
        "busy": {
          "type": "boolean"
        },
        "feedback": {
          "type": "string"
        },
        "providers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "title",
              "cost"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "cost": {
                "type": "string"
              }
            }
          }
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "group",
              "title",
              "ok",
              "detail",
              "instructions",
              "primary",
              "secondary"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "group": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "ok": {
                "type": "boolean"
              },
              "detail": {
                "type": "string"
              },
              "instructions": {
                "type": "string"
              },
              "primary": {
                "type": "string",
                "description": "Etichetta del pulsante principale (\"\" = nessuno)."
              },
              "secondary": {
                "type": "string"
              }
            }
          }
        },
        "auth": {
          "enum": [
            "",
            "github",
            "claudecode",
            "key",
            "openai"
          ]
        },
        "authOk": {
          "type": "boolean"
        },
        "authDetail": {
          "type": "string"
        },
        "endpoint": {
          "type": "string"
        },
        "models": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "value",
              "label"
            ],
            "properties": {
              "value": {
                "type": "string"
              },
              "label": {
                "type": "string"
              }
            }
          }
        },
        "model": {
          "type": "string"
        },
        "canNext": {
          "type": "boolean"
        }
      }
    },
    "revPicker": {
      "type": "object",
      "additionalProperties": false,
      "description": "Scelta guidata della revisione per \"Update to revision\" (finestra modale).",
      "required": [
        "open",
        "target",
        "loading",
        "error",
        "canMore",
        "items"
      ],
      "properties": {
        "open": {
          "type": "boolean"
        },
        "target": {
          "type": "string",
          "description": "Percorso che verra' aggiornato."
        },
        "loading": {
          "type": "boolean"
        },
        "error": {
          "type": "string",
          "description": "Es. numero non valido."
        },
        "canMore": {
          "type": "boolean",
          "description": "Ha senso \"Carica altre\"."
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "rev",
              "author",
              "date",
              "msg"
            ],
            "properties": {
              "rev": {
                "type": "integer",
                "minimum": 1
              },
              "author": {
                "type": "string"
              },
              "date": {
                "type": "string",
                "description": "ISO 8601."
              },
              "msg": {
                "type": "string",
                "description": "Prima riga del messaggio."
              }
            }
          }
        }
      }
    },
    "switchPicker": {
      "type": "object",
      "additionalProperties": false,
      "description": "Selettore di \"SVN Switch...\" (finestra modale): trunk, branch e tag del repository.",
      "required": [
        "open",
        "mode",
        "loading",
        "error",
        "items"
      ],
      "properties": {
        "open": {
          "type": "boolean"
        },
        "mode": {
          "enum": [
            "switch",
            "merge"
          ],
          "description": "switch = SVN Switch; merge = sorgente di SVN Merge (senza il ramo corrente)."
        },
        "loading": {
          "type": "boolean"
        },
        "error": {
          "type": "string",
          "description": "Es. elenco non leggibile, elemento non valido."
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "kind",
              "current"
            ],
            "properties": {
              "name": {
                "type": "string",
                "description": "Relativo alla base: trunk, branches/x, tags/1.0."
              },
              "kind": {
                "enum": [
                  "trunk",
                  "branch",
                  "tag"
                ]
              },
              "current": {
                "type": "boolean",
                "description": "E' il ramo su cui si trova la working copy."
              },
              "incomplete": {
                "type": "boolean",
                "description": "Destinazione di uno switch interrotto a meta' (facoltativo, solo true): sceglierla completa lo switch."
              },
              "rev": {
                "type": "integer",
                "minimum": 0,
                "description": "Ultima revisione che ha toccato il ramo (svn list --xml); 0 = sconosciuta."
              },
              "author": {
                "type": "string"
              },
              "date": {
                "type": "string",
                "description": "ISO 8601 dell'ultima modifica, vuota se sconosciuta."
              }
            }
          }
        },
        "recent": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Ultimi nomi usati per questo repository (piu recente per primo), solo quelli ancora in elenco."
        }
      }
    },
    "conflicts": {
      "type": "array",
      "description": "Sezione Conflitti: un elemento per file in conflitto, con le azioni conflictOp (edit solo per kind text, mine/theirs solo per text e property; resolved sempre, con conferma per tree).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "path",
          "name",
          "kind",
          "files"
        ],
        "properties": {
          "key": {
            "type": "string",
            "description": "Chiave di riga (changes:percorso) da passare a conflictOp."
          },
          "path": {
            "type": "string",
            "description": "Percorso relativo alla working copy."
          },
          "name": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "text",
              "property",
              "tree"
            ]
          },
          "files": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "File di appoggio di svn (da svn info --xml), relativi alla working copy: spariscono dopo il resolve."
          }
        }
      }
    },
    "merge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "conflicts"
      ],
      "description": "Banner dopo un merge non ancora committato: azioni Annulla merge (mergeUndo) e Nascondi (mergeDismiss). Assente se non c'e.",
      "properties": {
        "text": {
          "type": "string"
        },
        "conflicts": {
          "type": "integer",
          "minimum": 0,
          "description": "Elementi rimasti in conflitto."
        }
      }
    },
    "progress": {
      "type": "object",
      "additionalProperties": false,
      "description": "Finestra di avanzamento modale (switch, merge, update, cleanup): resta aperta a fine operazione con il riepilogo; si chiude con progressClose. svn non da un totale: barra indeterminata + processed. lines = ultime righe di notifica di svn.",
      "required": [
        "op",
        "title",
        "phase",
        "running",
        "ok",
        "processed",
        "conflicts",
        "omitted",
        "lines",
        "summary"
      ],
      "properties": {
        "op": {
          "enum": [
            "switch",
            "merge",
            "update",
            "cleanup"
          ]
        },
        "title": {
          "type": "string"
        },
        "phase": {
          "type": "string"
        },
        "running": {
          "type": "boolean"
        },
        "ok": {
          "type": "boolean"
        },
        "processed": {
          "type": "integer",
          "minimum": 0
        },
        "conflicts": {
          "type": "integer",
          "minimum": 0
        },
        "omitted": {
          "type": "integer",
          "minimum": 0,
          "description": "Righe piu vecchie non piu in lines."
        },
        "lines": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "k",
              "t"
            ],
            "properties": {
              "k": {
                "enum": [
                  "U",
                  "A",
                  "D",
                  "G",
                  "R",
                  "C",
                  "i"
                ]
              },
              "t": {
                "type": "string"
              }
            }
          }
        },
        "summary": {
          "type": "string"
        },
        "conflictPaths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cancellable": {
          "type": "boolean",
          "description": "Mostra Annulla (opCancel): switch, merge, update mentre girano; mai per il cleanup."
        },
        "cancelling": {
          "type": "boolean",
          "description": "Annullamento richiesto: Annulla disabilitato (\"Annullamento...\")."
        },
        "cancelled": {
          "type": "boolean",
          "description": "Terminata per annullamento: la working copy puo essere rimasta a meta o sporca."
        },
        "actions": {
          "type": "array",
          "description": "Passi proposti dopo un annullamento (cmd = comando UI).",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label",
              "cmd"
            ],
            "properties": {
              "label": {
                "type": "string"
              },
              "cmd": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "switchWarn": {
      "type": "object",
      "additionalProperties": false,
      "description": "Avviso prima dello switch su una working copy sporca: switchWarnContinue / switchWarnCleanup / switchWarnCancel. total 0 = dopo il Cleanup ora e pulita.",
      "required": [
        "target",
        "counts",
        "total"
      ],
      "properties": {
        "target": {
          "type": "string"
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "modified",
            "added",
            "deleted",
            "conflicted",
            "unversioned"
          ],
          "properties": {
            "modified": {
              "type": "integer",
              "minimum": 0
            },
            "added": {
              "type": "integer",
              "minimum": 0
            },
            "deleted": {
              "type": "integer",
              "minimum": 0
            },
            "conflicted": {
              "type": "integer",
              "minimum": 0
            },
            "unversioned": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "description": "Finestra delle opzioni del Cleanup (cleanupOk / cleanupCancel). extras falso = svn < 1.9: le opzioni oltre il cleanup semplice sono disabilitate. from = destinazione dello switch a cui si torna.",
      "required": [
        "extras",
        "svnVersion",
        "from"
      ],
      "properties": {
        "extras": {
          "type": "boolean"
        },
        "svnVersion": {
          "type": "string"
        },
        "from": {
          "type": "string"
        }
      }
    }
  },
  "$defs": {
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "kind",
        "depth",
        "name",
        "status",
        "can"
      ],
      "properties": {
        "key": {
          "type": "string",
          "description": "Chiave di riga: \"<sezione>:<percorso/con/slash>\" oppure \"section:<id>\" (sezione intera). La UI non manda mai percorsi assoluti."
        },
        "kind": {
          "enum": [
            "file",
            "folder"
          ]
        },
        "depth": {
          "type": "integer",
          "minimum": 0,
          "description": "Livello di indentazione (0 = figli diretti della sezione)."
        },
        "name": {
          "type": "string",
          "description": "Etichetta; le cartelle singole sono compattate (\"Core/Services\")."
        },
        "detail": {
          "type": "string",
          "description": "Cartella del file (solo vista elenco)."
        },
        "dir": {
          "type": "boolean",
          "description": "File-kind che e' in realta' una cartella (non versionata o con proprieta')."
        },
        "expanded": {
          "type": "boolean",
          "description": "Solo cartelle."
        },
        "count": {
          "type": "integer",
          "minimum": 0,
          "description": "Solo cartelle: file contenuti."
        },
        "status": {
          "enum": [
            "M",
            "A",
            "D",
            "C",
            "?",
            "!",
            "R",
            "K",
            null
          ],
          "description": "Lettera svn; K = file solo bloccato (lock) da te; null per le cartelle."
        },
        "statusText": {
          "type": "string",
          "description": "Testo esteso per tooltip/aria."
        },
        "can": {
          "type": "object",
          "additionalProperties": false,
