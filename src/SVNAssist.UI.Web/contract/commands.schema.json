          "properties": {
            "op": {
              "enum": [
                "add",
                "ignore",
                "revert",
                "resolve",
                "deleteFile",
                "lock",
                "unlock"
              ],
              "description": "deleteFile = tasto Canc: elimina dal filesystem (svn delete se versionato). L'host chiede conferma. lock = svn lock con messaggio facoltativo (se e' di un altro l'host chiede conferma esplicita per rubarlo, --force); unlock = svn unlock."
            },
            "key": {
              "type": "string",
              "description": "Chiave di riga: \"<sezione>:<percorso/con/slash>\" oppure \"section:<id>\" (sezione intera). La UI non manda mai percorsi assoluti."
