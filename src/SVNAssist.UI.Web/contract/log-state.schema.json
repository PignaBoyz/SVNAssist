{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "log-state.schema.json",
  "title": "Stato della vista Log",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "path",
    "msg",
    "err",
    "loading",
    "canMore",
    "sel",
    "entries",
    "diff"
  ],
  "properties": {
    "path": {
      "type": "string"
    },
    "msg": {
      "type": "string"
    },
    "err": {
      "type": "boolean"
    },
    "loading": {
      "type": "boolean"
    },
    "canMore": {
      "type": "boolean"
    },
    "sel": {
      "type": [
        "integer",
        "null"
      ],
      "description": "Revisione selezionata."
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rev",
          "author",
          "date",
          "msg",
          "paths"
        ],
        "properties": {
          "rev": {
            "type": "integer",
            "minimum": 1,
            "description": ""
          },
          "author": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}T",
            "description": "ISO 8601."
          },
          "msg": {
            "type": "string"
          },
          "depth": {
            "type": "integer",
            "minimum": 1,
            "description": "Assente = revisione del log. >0: entrata per merge (svn log -g), annidata sotto la revisione di merge che la precede."
          },
          "reverse": {
            "type": "boolean",
            "description": "Solo se vero: reverse-merge (la revisione e' stata tolta dal merge)."
          },
          "paths": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "a",
                "p"
              ],
              "properties": {
                "a": {
                  "enum": [
                    "A",
                    "M",
                    "D",
                    "R"
                  ]
                },
                "p": {
                  "type": "string"
                },
                "k": {
                  "enum": [
                    "dir",
                    "file"
                  ],
                  "description": "dir: cartella (non si apre nel diff). Assente = file."
                }
              }
            }
          },
          "wi": {
            "type": "array",
            "description": "Azure DevOps attivo: work item citati nel messaggio (formato dell'estensione), con stato attuale. Assente altrimenti.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "type",
                "title",
                "state",
                "url"
              ],
              "properties": {
                "id": {
                  "type": "integer",
                  "minimum": 1
                },
                "type": {
                  "type": "string",
                  "description": "Bug, Task, Feature..."
                },
                "title": {
                  "type": "string"
                },
                "state": {
                  "type": "string",
                  "description": "Stato attuale in Azure."
                },
                "url": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "stopOnCopy": {
      "type": "boolean",
      "description": "Opzione Show Log: ferma la storia a copie e rinomina (--stop-on-copy). Default vero."
    },
    "includeMerged": {
      "type": "boolean",
      "description": "Opzione Show Log: include le revisioni entrate per merge (svn log -g), con entries[].depth > 0."
    },
    "diff": {
      "type": "string",
      "description": "Diff unificato (svn diff -c) della revisione selezionata; \"\" se nessuna."
    },
    "filter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "author",
        "text",
        "path",
        "from",
        "to"
      ],
      "description": "Filtri attivi come scritti dall'utente; date aaaa-mm-gg.",
      "properties": {
        "author": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        }
      }
    },
    "files": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "kind",
        "title",
        "items"
      ],
      "description": "Elenco di file con diff a due pannelli: folder (modifiche di una cartella) o compare (due revisioni). Sostituisce il dettaglio revisione.",
      "properties": {
        "kind": {
          "enum": [
            "folder",
            "compare"
          ]
        },
        "title": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "a",
              "p"
            ],
            "properties": {
              "a": {
                "enum": [
                  "A",
                  "M",
                  "D",
                  "R"
                ]
              },
              "p": {
                "type": "string"
              },
              "k": {
                "enum": [
                  "dir",
                  "file"
                ]
              }
            }
          }
        }
      }
    },
    "merge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "title",
        "loading",
        "busy",
        "error",
        "blocked",
        "selected",
        "eligible",
        "result"
      ],
      "description": "Presente solo nel Log in modalita merge: entries = revisioni ancora da unire (svn mergeinfo --show-revs eligible + svn log sul sorgente); sel e sempre null, la scelta e merge.selected.",
      "properties": {
        "source": {
          "type": "string",
          "description": "Voce scelta: trunk, branches/x, tags/1.0."
        },
        "title": {
          "type": "string",
          "description": "Es. Merge da branches/x."
        },
        "loading": {
          "type": "boolean"
        },
        "busy": {
          "type": "boolean",
          "description": "Anteprima o merge in corso."
        },
        "error": {
          "type": "string"
        },
        "blocked": {
          "type": "string",
          "description": "Perche non si puo unire (conflitti, file mancanti o elementi a meta nella working copy: dopo un merge non si ripristinano in modo affidabile); vuoto se si puo. Le modifiche pendenti (M, A, D, R) NON bloccano: vedi dirty. La UI affianca i pulsanti SVN Revert di tutto (mergeRevertAll) e Vai a Changes (mergeResolve)."
        },
        "selected": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "description": "Revisioni scelte per il cherry-pick."
        },
        "eligible": {
          "type": "integer",
          "minimum": 0,
          "description": "Numero di revisioni da unire."
        },
        "needsUpdate": {
          "type": "boolean",
          "description": "L errore suggerisce SVN Update (revisioni miste, E195020): la UI mostra il pulsante SVN Update ora (mergeUpdate)."
        },
        "pending": {
          "type": "boolean",
          "description": "Merge eseguito e non ancora committato ne annullato: la UI mostra Merge eseguito, da committare al posto di 0 revisioni da unire."
        },
        "result": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "mode",
            "revs",
            "counts",
            "items",
            "skipped"
          ],
          "description": "Esito dell'ultima anteprima (preview) o dell'ultimo merge (merge).",
          "properties": {
            "mode": {
              "enum": [
                "preview",
                "merge"
              ]
            },
            "revs": {
              "type": "string",
              "description": "Es. r120-r135 oppure r120, r124."
            },
            "counts": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "updated",
                "added",
                "deleted",
                "merged",
                "conflicted"
              ],
              "properties": {
                "updated": {
                  "type": "integer",
                  "minimum": 0
                },
                "added": {
                  "type": "integer",
                  "minimum": 0
                },
                "deleted": {
                  "type": "integer",
                  "minimum": 0
                },
                "merged": {
                  "type": "integer",
                  "minimum": 0
                },
                "conflicted": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "a",
                  "p"
                ],
                "properties": {
                  "a": {
                    "enum": [
                      "A",
                      "M",
                      "D",
                      "R",
                      "C"
                    ]
                  },
                  "p": {
                    "type": "string"
                  },
                  "k": {
                    "enum": [
                      "dir",
                      "file"
                    ]
                  }
                }
              }
            },
            "skipped": {
              "type": "integer",
              "minimum": 0
            },
            "byRev": {
              "type": "array",
              "description": "Solo anteprima: per ogni revisione (dalla piu' vecchia) i file che tocca (svn log -v), con c vero sui file che il dry-run complessivo prevede in conflitto.",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "rev",
                  "author",
                  "msg",
                  "files",
                  "more"
                ],
                "properties": {
                  "rev": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "author": {
                    "type": "string"
                  },
                  "msg": {
                    "type": "string",
                    "description": "Prima riga del messaggio."
                  },
                  "files": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "a",
                        "p"
                      ],
                      "properties": {
                        "a": {
                          "enum": [
                            "A",
                            "M",
                            "D",
                            "R"
                          ]
                        },
                        "p": {
                          "type": "string",
                          "description": "Percorso relativo al ramo (uguale a quello della working copy)."
                        },
                        "n": {
                          "type": "integer",
                          "minimum": 1,
                          "description": "Solo nell'elenco unito: quante delle revisioni considerate toccano il file."
                        },
                        "k": {
                          "enum": [
                            "dir"
                          ],
                          "description": "Cartella (non si apre nel diff). Assente = file."
                        },
                        "c": {
                          "type": "boolean",
                          "description": "Solo nell'anteprima: il dry-run prevede un conflitto su questo file."
                        }
                      }
                    }
                  },
                  "more": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "conflicts": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            },
            "byRevMore": {
              "type": "integer",
              "minimum": 1,
              "description": "Revisioni non elencate in byRev."
            }
          }
        },
        "files": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "subject",
            "focus",
            "loading",
            "error",
            "items",
            "files",
            "more"
          ],
          "description": "File coinvolti dalla scelta (unione delle revisioni scelte, con l'effetto netto) o, con focus vero, da una sola revisione scelta dal menu contestuale (mergeFocus). Assente se non c'e' ne' scelta ne' focus. Si legge in modo asincrono (svn log -v solo per le revisioni scelte, in cache); clic su un file = mergeFileOpen.",
          "properties": {
            "subject": {
              "type": "string",
              "description": "Es. r120, r124 oppure r120."
            },
            "focus": {
              "type": "boolean",
              "description": "Mostra una sola revisione (menu contestuale) al posto della scelta: la UI offre Torna alla scelta (mergeFocus rev 0)."
            },
            "loading": {
              "type": "boolean"
            },
            "error": {
              "type": "string"
            },
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "a",
                  "p"
                ],
                "properties": {
                  "a": {
                    "enum": [
                      "A",
                      "M",
                      "D",
                      "R"
                    ]
                  },
                  "p": {
                    "type": "string",
                    "description": "Percorso relativo al ramo (uguale a quello della working copy)."
                  },
                  "n": {
                    "type": "integer",
                    "minimum": 1,
                    "description": "Solo nell'elenco unito: quante delle revisioni considerate toccano il file."
                  },
                  "k": {
                    "enum": [
                      "dir"
                    ],
                    "description": "Cartella (non si apre nel diff). Assente = file."
                  },
                  "c": {
                    "type": "boolean",
                    "description": "Solo nell'anteprima: il dry-run prevede un conflitto su questo file."
                  }
                }
              }
            },
            "files": {
              "type": "integer",
              "minimum": 0,
              "description": "File veri (cartelle escluse)."
            },
            "more": {
              "type": "integer",
              "minimum": 0,
              "description": "Voci non elencate (limite dell'elenco)."
            }
          }
        },
        "dirty": {
          "type": "integer",
          "minimum": 1,
          "description": "Elementi con modifiche pendenti (M, A, D, R); assente se zero. Non bloccano il merge: prima si chiede conferma (con i file in comune col merge, a rischio di conflitto) e si salva una copia di sicurezza in .svn-assist/backups che Annulla merge ripristina."
        },
        "interrupted": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source",
            "kind",
            "total",
            "applied",
            "remaining",
            "appliedText",
            "remainingText",
            "steps",
            "alternative",
            "conflictRev",
            "unresolved",
            "canContinue",
            "whyNot",
            "incompatible",
            "warning",
            "appliedRevs",
            "remainingRevs",
            "hasBackup",
            "busy"
          ],
          "description": "Merge di piu revisioni fermo o interrotto (conflitto, Annulla dell'utente, errore, VS chiuso). Stato su disco per working copy (pending-merge.json): sopravvive alla chiusura di VS. I testi sono gia localizzati dal backend. Azioni: Continua merge (mergeContinue, disabilitato con whyNot finche restano conflitti), Annulla merge (mergeUndo), Scarta stato (mergeDiscard, solo se incompatible).",
          "properties": {
            "source": {
              "type": "string",
              "description": "Sorgente (branches/x, con /sottopercorso per il merge di una cartella)."
            },
            "kind": {
              "enum": [
                "stopped",
                "interrupted"
              ],
              "description": "stopped = fermo dopo la revisione in conflitto; interrupted = fermato dall'utente, da un errore o da VS chiuso."
            },
            "total": {
              "type": "integer",
              "minimum": 0,
              "description": "Revisioni dell'intero merge."
            },
            "applied": {
              "type": "integer",
              "minimum": 0
            },
            "remaining": {
              "type": "integer",
              "minimum": 0
            },
            "appliedText": {
              "type": "string",
              "description": "Es. Applicate 3 di 7: r14040, r14041, r14042; ferma alla r14042 per conflitto in 2 file."
            },
            "remainingText": {
              "type": "string",
              "description": "Es. Rimaste 4: r14043…r14046."
            },
            "steps": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Passi numerati: risolvi i conflitti, segna come risolti (solo con conflitti), premi Continua merge."
            },
            "alternative": {
              "type": "string",
              "description": "Alternativa: Annulla merge."
            },
            "conflictRev": {
              "type": [
                "integer",
                "null"
              ],
              "description": "Revisione dopo cui si e fermato per conflitto; null se non nota (conflitto dentro un gruppo applicato in un colpo)."
            },
            "unresolved": {
              "type": "integer",
              "minimum": 0,
              "description": "File ancora in conflitto sotto la cartella del merge."
            },
            "canContinue": {
              "type": "boolean",
              "description": "Continua merge abilitato."
            },
            "whyNot": {
              "type": "string",
              "description": "Perche Continua merge e disabilitato (conflitti aperti, working copy cambiata); vuoto se abilitato."
            },
            "incompatible": {
              "type": "boolean",
              "description": "Working copy cambiata (switch, update, revert): restano solo Annulla merge e Scarta stato."
            },
            "warning": {
              "type": "string",
              "description": "Passaggio terminato a forza: puo essere applicato a meta; vuoto altrimenti."
            },
            "appliedRevs": {
              "type": "array",
              "items": {
                "type": "integer"
              },
              "description": "Revisioni applicate in questo merge."
            },
            "remainingRevs": {
              "type": "array",
              "items": {
                "type": "integer"
              },
              "description": "Revisioni rimaste da applicare."
            },
            "hasBackup": {
              "type": "boolean",
              "description": "C'e una copia di sicurezza delle modifiche pendenti di prima del merge (Annulla merge le ripristina)."
            },
            "busy": {
              "type": "boolean"
            }
          }
        },
        "appliedInfo": {
          "type": "array",
          "description": "Revisioni applicate nel merge interrotto con autore e messaggio (prime 100): la UI le marca applicata in questo merge. Non sono piu tra le entries (mergeinfo).",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "rev",
              "author",
              "msg"
            ],
            "properties": {
              "rev": {
                "type": "integer"
              },
              "author": {
                "type": "string"
              },
              "msg": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "progress": {
      "type": "object",
      "additionalProperties": false,
      "description": "Finestra di avanzamento modale (switch, merge, update, cleanup): resta aperta a fine operazione con il riepilogo; si chiude con progressClose. svn non da un totale: barra indeterminata + processed. lines = ultime righe di notifica di svn.",
      "required": [
        "op",
        "title",
        "phase",
        "running",
        "ok",
        "processed",
        "conflicts",
        "omitted",
        "lines",
        "summary"
      ],
      "properties": {
        "op": {
          "enum": [
            "switch",
            "merge",
            "update",
            "cleanup"
          ]
        },
        "title": {
          "type": "string"
        },
        "phase": {
          "type": "string"
        },
        "running": {
          "type": "boolean"
        },
        "ok": {
          "type": "boolean"
        },
        "processed": {
          "type": "integer",
          "minimum": 0
        },
        "conflicts": {
          "type": "integer",
          "minimum": 0
        },
        "omitted": {
          "type": "integer",
          "minimum": 0,
          "description": "Righe piu vecchie non piu in lines."
        },
        "lines": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "k",
              "t"
            ],
            "properties": {
              "k": {
                "enum": [
                  "U",
                  "A",
                  "D",
                  "G",
                  "R",
                  "C",
                  "i"
                ]
              },
              "t": {
                "type": "string"
              }
            }
          }
        },
        "summary": {
          "type": "string"
        },
        "conflictPaths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cancellable": {
          "type": "boolean",
          "description": "Mostra Annulla (opCancel): switch, merge, update mentre girano; mai per il cleanup."
        },
        "warnings": {
          "type": "boolean",
          "description": "Finita bene ma con avvisi (es. Cleanup: file in uso saltati): riepilogo in giallo."
        },
        "origin": {
          "enum": [
            "changes",
            "log"
          ],
          "description": "Vista che ha avviato l'operazione: li la finestra completa; nell'altra una striscia sottile non bloccante col rimando."
        },
        "cancelling": {
          "type": "boolean",
          "description": "Annullamento richiesto: Annulla disabilitato (\"Annullamento...\")."
        },
        "cancelled": {
          "type": "boolean",
          "description": "Terminata per annullamento: la working copy puo essere rimasta a meta o sporca."
        },
        "actions": {
          "type": "array",
          "description": "Passi proposti dopo un annullamento (cmd = comando UI).",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label",
              "cmd"
            ],
            "properties": {
              "label": {
                "type": "string"
              },
              "cmd": {
                "type": "string"
              }
            }
          }
        },
        "step": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "label",
            "first",
            "last",
            "done",
            "total"
          ],
          "description": "Avanzamento per revisione di un merge: Applico rN (k di TOT); first/last = posizioni (da 1) nell'intero merge, done = revisioni gia applicate, total = revisioni del merge. Un gruppo applicato in un colpo ha label r1-r2 e first < last.",
          "properties": {
            "label": {
              "type": "string"
            },
            "first": {
              "type": "integer",
              "minimum": 0
            },
            "last": {
              "type": "integer",
              "minimum": 0
            },
            "done": {
              "type": "integer",
              "minimum": 0
            },
            "total": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "base": {
      "type": "string",
      "description": "Percorso nel repository della cartella o del file di cui si legge il log (es. /trunk/src). Serve all'opzione Solo percorsi interessati: i percorsi di una revisione fuori da qui si nascondono."
    },
    "updateScope": {
      "enum": [
        "wc",
        "file",
        "dir"
      ],
      "description": "Cosa si puo' aggiornare dal tasto destro (Update a questa revisione): wc = il log e' della radice della working copy; file/dir = di un elemento dentro (si offre anche solo quello). Assente per il log di un URL."
    },
    "logTheme": {
      "enum": [
        "same",
        "light",
        "dark"
      ],
      "description": "Tema della sola finestra Log: same = come le altre finestre SVNAssist."
    },
    "current": {
      "type": "integer",
      "minimum": 0,
      "description": "Revisione dell'elenco in cui si trova la working copy (la piu' recente non successiva alla revisione di svn info): la riga si evidenzia. Assente per il log di un URL."
    }
  }
}
