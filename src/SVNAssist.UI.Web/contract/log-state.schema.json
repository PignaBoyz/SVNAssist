{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "log-state.schema.json",
  "title": "Stato della vista Log",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "path",
    "msg",
    "err",
    "loading",
    "canMore",
    "sel",
    "entries",
    "diff"
  ],
  "properties": {
    "path": {
      "type": "string"
    },
    "msg": {
      "type": "string"
    },
    "err": {
      "type": "boolean"
    },
    "loading": {
      "type": "boolean"
    },
    "canMore": {
      "type": "boolean"
    },
    "sel": {
      "type": [
        "integer",
        "null"
      ],
      "description": "Revisione selezionata."
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rev",
          "author",
          "date",
          "msg",
          "paths"
        ],
        "properties": {
          "rev": {
            "type": "integer",
            "minimum": 1,
            "description": ""
          },
          "author": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}T",
            "description": "ISO 8601."
          },
          "msg": {
            "type": "string"
          },
          "paths": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "a",
                "p"
              ],
              "properties": {
                "a": {
                  "enum": [
                    "A",
                    "M",
                    "D",
                    "R"
                  ]
                },
                "p": {
                  "type": "string"
                },
                "k": {
                  "enum": [
                    "dir",
                    "file"
                  ],
                  "description": "dir: cartella (non si apre nel diff). Assente = file."
                }
              }
            }
          }
        }
      }
    },
    "diff": {
      "type": "string",
      "description": "Diff unificato (svn diff -c) della revisione selezionata; \"\" se nessuna."
    },
    "filter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "author",
        "text",
        "path",
        "from",
        "to"
      ],
      "description": "Filtri attivi come scritti dall'utente; date aaaa-mm-gg.",
      "properties": {
        "author": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        }
      }
    },
    "files": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "kind",
        "title",
        "items"
      ],
      "description": "Elenco di file con diff a due pannelli: folder (modifiche di una cartella) o compare (due revisioni). Sostituisce il dettaglio revisione.",
      "properties": {
        "kind": {
          "enum": [
            "folder",
            "compare"
          ]
        },
        "title": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "a",
              "p"
            ],
            "properties": {
              "a": {
                "enum": [
                  "A",
                  "M",
                  "D",
                  "R"
                ]
              },
              "p": {
                "type": "string"
              },
              "k": {
                "enum": [
                  "dir",
                  "file"
                ]
              }
            }
          }
        }
      }
    }
  }
}
