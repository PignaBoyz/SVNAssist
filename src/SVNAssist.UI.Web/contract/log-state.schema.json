{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "log-state.schema.json",
  "title": "Stato della vista Log",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "path",
    "msg",
    "err",
    "loading",
    "canMore",
    "sel",
    "entries",
    "diff"
  ],
  "properties": {
    "path": {
      "type": "string"
    },
    "msg": {
      "type": "string"
    },
    "err": {
      "type": "boolean"
    },
    "loading": {
      "type": "boolean"
    },
    "canMore": {
      "type": "boolean"
    },
    "sel": {
      "type": [
        "integer",
        "null"
      ],
      "description": "Revisione selezionata."
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rev",
          "author",
          "date",
          "msg",
          "paths"
        ],
        "properties": {
          "rev": {
            "type": "integer",
            "minimum": 1,
            "description": ""
          },
          "author": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}T",
            "description": "ISO 8601."
          },
          "msg": {
            "type": "string"
          },
          "depth": {
            "type": "integer",
            "minimum": 1,
            "description": "Assente = revisione del log. >0: entrata per merge (svn log -g), annidata sotto la revisione di merge che la precede."
          },
          "reverse": {
            "type": "boolean",
            "description": "Solo se vero: reverse-merge (la revisione e' stata tolta dal merge)."
          },
          "paths": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "a",
                "p"
              ],
              "properties": {
                "a": {
                  "enum": [
                    "A",
                    "M",
                    "D",
                    "R"
                  ]
                },
                "p": {
                  "type": "string"
                },
                "k": {
                  "enum": [
                    "dir",
                    "file"
                  ],
                  "description": "dir: cartella (non si apre nel diff). Assente = file."
                }
              }
            }
          }
        }
      }
    },
    "stopOnCopy": {
      "type": "boolean",
      "description": "Opzione Show Log: ferma la storia a copie e rinomina (--stop-on-copy). Default vero."
    },
    "includeMerged": {
      "type": "boolean",
      "description": "Opzione Show Log: include le revisioni entrate per merge (svn log -g), con entries[].depth > 0."
    },
    "diff": {
      "type": "string",
      "description": "Diff unificato (svn diff -c) della revisione selezionata; \"\" se nessuna."
    },
    "filter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "author",
        "text",
        "path",
        "from",
        "to"
      ],
      "description": "Filtri attivi come scritti dall'utente; date aaaa-mm-gg.",
      "properties": {
        "author": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        }
      }
    },
    "files": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "kind",
        "title",
        "items"
      ],
      "description": "Elenco di file con diff a due pannelli: folder (modifiche di una cartella) o compare (due revisioni). Sostituisce il dettaglio revisione.",
      "properties": {
        "kind": {
          "enum": [
            "folder",
            "compare"
          ]
        },
        "title": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "a",
              "p"
            ],
            "properties": {
              "a": {
                "enum": [
                  "A",
                  "M",
                  "D",
                  "R"
                ]
              },
              "p": {
                "type": "string"
              },
              "k": {
                "enum": [
                  "dir",
                  "file"
                ]
              }
            }
          }
        }
      }
    },
    "merge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "title",
        "loading",
        "busy",
        "error",
        "blocked",
        "selected",
        "eligible",
        "result"
      ],
      "description": "Presente solo nel Log in modalita merge: entries = revisioni ancora da unire (svn mergeinfo --show-revs eligible + svn log sul sorgente); sel e sempre null, la scelta e merge.selected.",
      "properties": {
        "source": {
          "type": "string",
          "description": "Voce scelta: trunk, branches/x, tags/1.0."
        },
        "title": {
          "type": "string",
          "description": "Es. Merge da branches/x."
        },
        "loading": {
          "type": "boolean"
        },
        "busy": {
          "type": "boolean",
          "description": "Anteprima o merge in corso."
        },
        "error": {
          "type": "string"
        },
        "blocked": {
          "type": "string",
          "description": "Perche non si puo unire (working copy con modifiche locali); vuoto se si puo. La UI affianca i pulsanti SVN Revert di tutto (mergeRevertAll) e Vai a Changes (mergeResolve)."
        },
        "selected": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "description": "Revisioni scelte per il cherry-pick."
        },
        "eligible": {
          "type": "integer",
          "minimum": 0,
          "description": "Numero di revisioni da unire."
        },
        "needsUpdate": {
          "type": "boolean",
          "description": "L errore suggerisce SVN Update (revisioni miste, E195020): la UI mostra il pulsante SVN Update ora (mergeUpdate)."
        },
        "pending": {
          "type": "boolean",
          "description": "Merge eseguito e non ancora committato ne annullato: la UI mostra Merge eseguito, da committare al posto di 0 revisioni da unire."
        },
        "result": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "mode",
            "revs",
            "counts",
            "items",
            "skipped"
          ],
          "description": "Esito dell'ultima anteprima (preview) o dell'ultimo merge (merge).",
          "properties": {
            "mode": {
              "enum": [
                "preview",
                "merge"
              ]
            },
            "revs": {
              "type": "string",
              "description": "Es. r120-r135 oppure r120, r124."
            },
            "counts": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "updated",
                "added",
                "deleted",
                "merged",
                "conflicted"
              ],
              "properties": {
                "updated": {
                  "type": "integer",
                  "minimum": 0
                },
                "added": {
                  "type": "integer",
                  "minimum": 0
                },
                "deleted": {
                  "type": "integer",
                  "minimum": 0
                },
                "merged": {
                  "type": "integer",
                  "minimum": 0
                },
                "conflicted": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "a",
                  "p"
                ],
                "properties": {
                  "a": {
                    "enum": [
                      "A",
                      "M",
                      "D",
                      "R",
                      "C"
                    ]
                  },
                  "p": {
                    "type": "string"
                  },
                  "k": {
                    "enum": [
                      "dir",
                      "file"
                    ]
                  }
                }
              }
            },
            "skipped": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "progress": {
      "type": "object",
      "additionalProperties": false,
      "description": "Finestra di avanzamento modale (switch, merge, update, cleanup): resta aperta a fine operazione con il riepilogo; si chiude con progressClose. svn non da un totale: barra indeterminata + processed. lines = ultime righe di notifica di svn.",
      "required": [
        "op",
        "title",
        "phase",
        "running",
        "ok",
        "processed",
        "conflicts",
        "omitted",
        "lines",
        "summary"
      ],
      "properties": {
        "op": {
          "enum": [
            "switch",
            "merge",
            "update",
            "cleanup"
          ]
        },
        "title": {
          "type": "string"
        },
        "phase": {
          "type": "string"
        },
        "running": {
          "type": "boolean"
        },
        "ok": {
          "type": "boolean"
        },
        "processed": {
          "type": "integer",
          "minimum": 0
        },
        "conflicts": {
          "type": "integer",
          "minimum": 0
        },
        "omitted": {
          "type": "integer",
          "minimum": 0,
          "description": "Righe piu vecchie non piu in lines."
        },
        "lines": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "k",
              "t"
            ],
            "properties": {
              "k": {
                "enum": [
                  "U",
                  "A",
                  "D",
                  "G",
                  "R",
                  "C",
                  "i"
                ]
              },
              "t": {
                "type": "string"
              }
            }
          }
        },
        "summary": {
          "type": "string"
        },
        "conflictPaths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
