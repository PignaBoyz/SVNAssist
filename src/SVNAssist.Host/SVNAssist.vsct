<?xml version="1.0" encoding="utf-8"?>
<CommandTable xmlns="http://schemas.microsoft.com/VisualStudio/2005-10-18/CommandTable" xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <Extern href="stdidcmd.h" />
  <Extern href="vsshlids.h" />

  <Commands package="guidSVNAssistPackage">
    <Menus>
      <!-- Extensions > SVNAssist -->
      <Menu guid="guidSVNAssistCmdSet" id="MenuMain" priority="0x0100" type="Menu">
        <Parent guid="guidSVNAssistCmdSet" id="GroupExtensions" />
        <Strings><ButtonText>SVNAssist</ButtonText></Strings>
      </Menu>
      <!-- Extensions > SVNAssist > Language / Lingua: Automatica | Italiano | English -->
      <Menu guid="guidSVNAssistCmdSet" id="MenuLang" priority="0x0100" type="Menu">
        <Parent guid="guidSVNAssistCmdSet" id="GroupLangHost" />
        <Strings><ButtonText>Language / Lingua</ButtonText></Strings>
      </Menu>
    </Menus>

    <Groups>
      <!-- IDM_VS_MENU_EXTENSIONS: il menu Extensions di VS 2022/2026 -->
      <Group guid="guidSVNAssistCmdSet" id="GroupExtensions" priority="0x0600">
        <Parent guid="guidVSMainMenu" id="Extensions" />
      </Group>
      <Group guid="guidSVNAssistCmdSet" id="GroupMainPrimary" priority="0x0000"><Parent guid="guidSVNAssistCmdSet" id="MenuMain" /></Group>
      <Group guid="guidSVNAssistCmdSet" id="GroupMainSecondary" priority="0x0100"><Parent guid="guidSVNAssistCmdSet" id="MenuMain" /></Group>
      <Group guid="guidSVNAssistCmdSet" id="GroupLangHost" priority="0x0200"><Parent guid="guidSVNAssistCmdSet" id="MenuMain" /></Group>
      <Group guid="guidSVNAssistCmdSet" id="GroupLang" priority="0x0000"><Parent guid="guidSVNAssistCmdSet" id="MenuLang" /></Group>

      <!-- Menu contestuale dell'editor di codice (anche il pannello destro del diff): "SVN: Revert Selected Changes" -->
      <Group guid="guidSVNAssistCmdSet" id="GroupCode" priority="0x0F00" />
      <!-- Menu contestuale di Solution Explorer (file, progetto, cartella): solo "Show Log". -->
      <Group guid="guidSVNAssistCmdSet" id="GroupSe" priority="0x0F00" />
    </Groups>

    <Buttons>
      <Button guid="guidSVNAssistCmdSet" id="CmdChanges" priority="0x0000" type="Button"><Parent guid="guidSVNAssistCmdSet" id="GroupMainPrimary" /><Strings><CommandName>SVNAssist.Changes</CommandName><ButtonText>SVN Changes</ButtonText></Strings></Button>
      <Button guid="guidSVNAssistCmdSet" id="CmdCommit" priority="0x0010" type="Button"><Parent guid="guidSVNAssistCmdSet" id="GroupMainPrimary" /><Strings><CommandName>SVNAssist.Commit</CommandName><ButtonText>Commit...</ButtonText></Strings></Button>
      <Button guid="guidSVNAssistCmdSet" id="CmdUpdate" priority="0x0000" type="Button"><Parent guid="guidSVNAssistCmdSet" id="GroupMainSecondary" /><Strings><CommandName>SVNAssist.Update</CommandName><ButtonText>Update</ButtonText></Strings></Button>
      <Button guid="guidSVNAssistCmdSet" id="CmdLog" priority="0x0010" type="Button"><Parent guid="guidSVNAssistCmdSet" id="GroupMainSecondary" /><Strings><CommandName>SVNAssist.Log</CommandName><ButtonText>Log / History</ButtonText></Strings></Button>
      <Button guid="guidSVNAssistCmdSet" id="CmdAiSetup" priority="0x0020" type="Button"><Parent guid="guidSVNAssistCmdSet" id="GroupMainSecondary" /><Strings><CommandName>SVNAssist.AiSetup</CommandName><ButtonText>Change AI Provider...</ButtonText></Strings></Button>

      <Button guid="guidSVNAssistCmdSet" id="CmdUpdateRev" priority="0x0005" type="Button"><Parent guid="guidSVNAssistCmdSet" id="GroupMainSecondary" /><Strings><CommandName>SVNAssist.UpdateToRevision</CommandName><ButtonText>Update to revision...</ButtonText></Strings></Button>
      <Button guid="guidSVNAssistCmdSet" id="CmdSwitch" priority="0x0006" type="Button"><Parent guid="guidSVNAssistCmdSet" id="GroupMainSecondary" /><Strings><CommandName>SVNAssist.Switch</CommandName><ButtonText>Switch...</ButtonText></Strings></Button>
      <Button guid="guidSVNAssistCmdSet" id="CmdMerge" priority="0x0007" type="Button"><Parent guid="guidSVNAssistCmdSet" id="GroupMainSecondary" /><Strings><CommandName>SVNAssist.Merge</CommandName><ButtonText>Merge...</ButtonText></Strings></Button>
      <Button guid="guidSVNAssistCmdSet" id="CmdCleanup" priority="0x0030" type="Button"><Parent guid="guidSVNAssistCmdSet" id="GroupMainSecondary" /><Strings><CommandName>SVNAssist.Cleanup</CommandName><ButtonText>Cleanup</ButtonText></Strings></Button>
      <Button guid="guidSVNAssistCmdSet" id="CmdNextChange" priority="0x0040" type="Button"><Parent guid="guidSVNAssistCmdSet" id="GroupMainSecondary" /><Strings><CommandName>SVNAssist.NextChange</CommandName><ButtonText>Next Change in Diff</ButtonText></Strings></Button>
      <Button guid="guidSVNAssistCmdSet" id="CmdPrevChange" priority="0x0041" type="Button"><Parent guid="guidSVNAssistCmdSet" id="GroupMainSecondary" /><Strings><CommandName>SVNAssist.PreviousChange</CommandName><ButtonText>Previous Change in Diff</ButtonText></Strings></Button>
      <Button guid="guidSVNAssistCmdSet" id="CmdRevertSel" priority="0x0000" type="Button"><Parent guid="guidSVNAssistCmdSet" id="GroupCode" /><Strings><CommandName>SVNAssist.RevertSelected</CommandName><ButtonText>SVN: Revert Selected Changes</ButtonText></Strings></Button>
      <Button guid="guidSVNAssistCmdSet" id="CmdSeLog" priority="0x0000" type="Button"><Parent guid="guidSVNAssistCmdSet" id="GroupSe" /><CommandFlag>DefaultInvisible</CommandFlag><CommandFlag>DynamicVisibility</CommandFlag><Strings><CommandName>SVNAssist.SeLog</CommandName><ButtonText>Show Log</ButtonText></Strings></Button>
      <Button guid="guidSVNAssistCmdSet" id="CmdLangAuto" priority="0x0000" type="Button"><Parent guid="guidSVNAssistCmdSet" id="GroupLang" /><Strings><CommandName>SVNAssist.LanguageAuto</CommandName><ButtonText>Automatica / Automatic (lingua di Visual Studio)</ButtonText></Strings></Button>
      <Button guid="guidSVNAssistCmdSet" id="CmdLangIt" priority="0x0010" type="Button"><Parent guid="guidSVNAssistCmdSet" id="GroupLang" /><Strings><CommandName>SVNAssist.LanguageItalian</CommandName><ButtonText>Italiano</ButtonText></Strings></Button>
      <Button guid="guidSVNAssistCmdSet" id="CmdLangEn" priority="0x0020" type="Button"><Parent guid="guidSVNAssistCmdSet" id="GroupLang" /><Strings><CommandName>SVNAssist.LanguageEnglish</CommandName><ButtonText>English</ButtonText></Strings></Button>
    </Buttons>
  </Commands>

  <CommandPlacements>
    <CommandPlacement guid="guidSVNAssistCmdSet" id="GroupCode" priority="0x0F00"><Parent guid="guidSHLMainMenu" id="IDM_VS_CTXT_CODEWIN" /></CommandPlacement>
    <!-- Anche nel menu contestuale dell'editor/diff, accanto a "Revert Selected Changes". -->
    <CommandPlacement guid="guidSVNAssistCmdSet" id="CmdNextChange" priority="0x0010"><Parent guid="guidSVNAssistCmdSet" id="GroupCode" /></CommandPlacement>
    <CommandPlacement guid="guidSVNAssistCmdSet" id="CmdPrevChange" priority="0x0011"><Parent guid="guidSVNAssistCmdSet" id="GroupCode" /></CommandPlacement>
    <CommandPlacement guid="guidSVNAssistCmdSet" id="GroupSe" priority="0x0F00"><Parent guid="guidSHLMainMenu" id="IDM_VS_CTXT_ITEMNODE" /></CommandPlacement>
    <CommandPlacement guid="guidSVNAssistCmdSet" id="GroupSe" priority="0x0F00"><Parent guid="guidSHLMainMenu" id="IDM_VS_CTXT_PROJNODE" /></CommandPlacement>
    <CommandPlacement guid="guidSVNAssistCmdSet" id="GroupSe" priority="0x0F00"><Parent guid="guidSHLMainMenu" id="IDM_VS_CTXT_FOLDERNODE" /></CommandPlacement>
  </CommandPlacements>

  <KeyBindings>
    <!-- Scope globale (il Difference Viewer non ha uno scope documentato): fuori da un diff il comando non fa nulla. -->
    <!-- Alt+F8 / Shift+Alt+F8: Ctrl+Alt+Giu'/Su' e' gia' di VS (Window.ShowEzMDIFileList, elenco dei documenti aperti). -->
    <KeyBinding guid="guidSVNAssistCmdSet" id="CmdNextChange" editor="guidVSStd97" mod1="Alt" key1="VK_F8" />
    <KeyBinding guid="guidSVNAssistCmdSet" id="CmdPrevChange" editor="guidVSStd97" mod1="Alt Shift" key1="VK_F8" />
  </KeyBindings>

  <Symbols>
    <GuidSymbol name="guidVSMainMenu" value="{D309F791-903F-11D0-9EFC-00A0C911004F}"><IDSymbol name="Extensions" value="0x0091" /></GuidSymbol>
    <GuidSymbol name="guidSVNAssistPackage" value="{7a3b2c1d-4e5f-4a60-8b71-9c0d1e2f3a41}" />
    <GuidSymbol name="guidSVNAssistCmdSet" value="{4d6e8f0a-3c5e-4071-9c9d-2e3f4a5b6c74}">
      <IDSymbol name="MenuMain" value="0x1000" />
      <IDSymbol name="MenuLang" value="0x1002" />
      <IDSymbol name="GroupLangHost" value="0x1114" />
      <IDSymbol name="GroupLang" value="0x1115" />
      <IDSymbol name="CmdLangAuto" value="0x011B" />
      <IDSymbol name="GroupCode" value="0x1116" />
      <IDSymbol name="GroupSe" value="0x1117" />
      <IDSymbol name="CmdSeLog" value="0x0113" />
      <IDSymbol name="CmdRevertSel" value="0x011E" />
      <IDSymbol name="CmdNextChange" value="0x011F" />
      <IDSymbol name="CmdPrevChange" value="0x0120" />
      <IDSymbol name="CmdLangIt" value="0x011C" />
      <IDSymbol name="CmdLangEn" value="0x011D" />
      <IDSymbol name="GroupExtensions" value="0x1100" />
      <IDSymbol name="GroupMainPrimary" value="0x1101" />
      <IDSymbol name="GroupMainSecondary" value="0x1102" />
      <IDSymbol name="CmdChanges" value="0x0100" />
      <IDSymbol name="CmdCommit" value="0x0101" />
      <IDSymbol name="CmdUpdate" value="0x0102" />
      <IDSymbol name="CmdLog" value="0x0103" />
      <IDSymbol name="CmdAiSetup" value="0x0104" />
      <IDSymbol name="CmdUpdateRev" value="0x0105" />
      <IDSymbol name="CmdSwitch" value="0x0107" />
      <IDSymbol name="CmdMerge" value="0x0108" />
      <IDSymbol name="CmdCleanup" value="0x0106" />
    </GuidSymbol>
  </Symbols>
</CommandTable>
