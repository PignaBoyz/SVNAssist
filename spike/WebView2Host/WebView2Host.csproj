<Project>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <UseWPF>true</UseWPF>
    <VssdkCompatibleExtension>true</VssdkCompatibleExtension>
    <RootNamespace>SVNAssist.Spike</RootNamespace>
    <AssemblyName>SVNAssist.Spike.WebView2Host</AssemblyName>
    <GeneratePkgDefFile>true</GeneratePkgDefFile>
    <UseCodebase>true</UseCodebase>
    <CreateVsixContainer>true</CreateVsixContainer>
    <DeployExtension>false</DeployExtension>
    <CopyBuildOutputToOutputDirectory>true</CopyBuildOutputToOutputDirectory>
    <NoWarn>$(NoWarn);MSB3277;VSEXTPREVIEW_SETTINGS;NU1701</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.SDK" Version="17.14.40265" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="17.14.2120" />
    <PackageReference Include="Microsoft.VisualStudio.Extensibility.Sdk" Version="17.14.40608" />
    <!-- Stessa versione di VS 18.12 (PrivateAssemblies): non si copia nel VSIX, la fornisce VS. -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3967.48" ExcludeAssets="runtime" />
    <PackageReference Include="StreamJsonRpc" Version="2.22.23" ExcludeAssets="runtime" />
    <Reference Include="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="ui\**" IncludeInVSIX="true" />
    <Content Include="..\EchoBackend\bin\publish\**" Link="backend\%(RecursiveDir)%(Filename)%(Extension)" IncludeInVSIX="true" />
  </ItemGroup>
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
  <Import Project="$(VSToolsPath)\VSSDK\Microsoft.VsSDK.targets" />
  <!-- Progetto SDK-style: il VSIX non parte da solo come nei vecchi csproj. -->
  <Target Name="MakeVsix" AfterTargets="Build" DependsOnTargets="CreateVsixContainer" />
</Project>
