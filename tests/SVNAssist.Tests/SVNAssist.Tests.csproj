<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Sopprime il warning VSTHRD200: i test xUnit non usano il suffisso Async -->
    <NoWarn>$(NoWarn);VSTHRD200</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.1.0" />
    <PackageReference Include="JsonSchema.Net" Version="7.3.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.1" />
    <PackageReference Include="RichardSzalay.MockHttp" Version="7.1.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SVNAssist.Backend\SVNAssist.Backend.csproj" />
    <Compile Include="..\..\src\Shared\DotnetRuntime.cs" Link="DotnetRuntime.cs" />
    <Compile Include="..\..\src\Shared\DiffNav.cs" Link="DiffNav.cs" />
    <Compile Include="..\..\src\Shared\SccGlyph.cs" Link="SccGlyph.cs" />
  </ItemGroup>

  <!-- Contratto UI (schemi + fixture): i test verificano che gli snapshot del backend li rispettino. -->
  <ItemGroup>
    <None Include="..\..\src\SVNAssist.UI.Web\contract\**\*.json" Link="contract\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
